  {
    "@id": "_:ne90de44f8be74bd69220e2bb55729ac0b3770",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n        CONSTRUCT {\n            $this brick:hasSubstance ?substance .\n        } WHERE {\n            $this rdf:type ?meter .\n            ?meter rdfs:subClassOf* brick:Meter .\n            ?meter brick:hasSubstance ?substance .\n        }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
