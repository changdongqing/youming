  {
    "@id": "_:ne90de44f8be74bd69220e2bb55729ac0b3783",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\nCONSTRUCT {\n    ?s a ?t2 .\n} WHERE {\n    ?s a $this .\n    { ?t2 owl:equivalentClass $this }\n    UNION\n    { $this owl:equivalentClass ?t2 }\n}"
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.4/Brick"
