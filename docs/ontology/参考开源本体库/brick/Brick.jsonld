  {
    "@id": "https://brickschema.org/schema/BrickShape#SensorInheritQuantityKind",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:ne90de44f8be74bd69220e2bb55729ac0b3879"
      }
    ],
    "http://www.w3.org/ns/shacl#target": [
      {
        "@id": "_:ne90de44f8be74bd69220e2bb55729ac0b3880"
      }
    ]
  },
  {
    "@id": "_:ne90de44f8be74bd69220e2bb55729ac0b3879",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\n        CONSTRUCT {\n            $this brick:hasQuantity ?quantity .\n        } WHERE {\n            $this rdfs:subClassOf+ ?parent .\n            ?parent brick:hasQuantity ?quantity .\n            FILTER NOT EXISTS {\n                $this brick:hasQuantity ?quantity .\n            }\n        }\n        "
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.4/Brick"
      }
    ]
  },
  {
    "@id": "_:ne90de44f8be74bd69220e2bb55729ac0b3880",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLTarget"
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n        PREFIX brick: <https://brickschema.org/schema/Brick#>\n        PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n            SELECT DISTINCT ?this WHERE {\n              ?this rdfs:subClassOf+ brick:Sensor\n            }\n        "
      }
    ]
  },
  {
    "@id": "https://brickschema.org/schema/Brick/ref#ExternalReferenceShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#property": [
