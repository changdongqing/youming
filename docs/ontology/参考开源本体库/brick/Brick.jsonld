    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n            SELECT $this\n            WHERE {\n                $this ref:hasExternalReference ?ref .\n                ?ref rdf:type ref:TimeseriesReference .\n                FILTER NOT EXISTS { $this rdf:type/rdfs:subClassOf* brick:Point }\n            }\n        "
