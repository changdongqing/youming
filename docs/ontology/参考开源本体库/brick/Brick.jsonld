      }
    ]
  },
  {
    "@id": "_:ne90de44f8be74bd69220e2bb55729ac0b3501",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "All ExternalReference must have an skos:definition"
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#integer",
        "@value": 1
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#definition"
      }
    ]
  },
  {
    "@id": "_:ne90de44f8be74bd69220e2bb55729ac0b3502",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLTarget"
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.4/Brick"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n    SELECT ?this WHERE {\n     ?this rdfs:subClassOf+ ref:ExternalReference .\n    }\n    "
      }
    ]
  },
