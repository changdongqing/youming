  {
    "@id": "https://brickschema.org/schema/BrickShape#RDFSRangeRule",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#rule": [
      {
        "@id": "_:ne90de44f8be74bd69220e2bb55729ac0b3856"
      }
    ],
    "http://www.w3.org/ns/shacl#targetSubjectsOf": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#range"
      }
    ]
  },
  {
    "@id": "_:ne90de44f8be74bd69220e2bb55729ac0b3856",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLRule"
    ],
    "http://www.w3.org/ns/shacl#construct": [
      {
        "@value": "\nCONSTRUCT {\n    ?val a ?shape .\n} WHERE {\n    $this rdfs:range ?shape .\n    ?shape a sh:NodeShape .\n    ?ent $this ?val .\n    FILTER NOT EXISTS { ?val a ?shape }\n}"
      }
    ],
    "http://www.w3.org/ns/shacl#prefixes": [
      {
        "@id": "https://brickschema.org/schema/1.4/Brick"
