      }
    ]
  },
  {
    "@id": "_:ne90de44f8be74bd69220e2bb55729ac0b3500",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "All ExternalReference must have an rdfs:label"
      }
