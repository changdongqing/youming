    "@id": "https://brickschema.org/schema/Brick#Fire_Alarm_Manual_Call_Point",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
