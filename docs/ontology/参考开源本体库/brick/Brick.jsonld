    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Lighting Correlated Color Temperature Command"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://en.wikipedia.org/wiki/Color_temperature#Correlated_color_temperature"
      }
    ],
